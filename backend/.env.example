# ============================================================
# KRISHIMIND AI — BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ============================================================

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./krishimind.db

# JWT & Authentication Security
JWT_SECRET=krishimind-secret-key-production-replace-with-secure-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini 3.7 Flash / Gemini Vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VISION_MODEL=gemini-3.7-flash

# ============================================================
# PINECONE VECTOR DATABASE (Official Agricultural RAG Store)
# ============================================================
VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=krishimind-agricultural-rag
PINECONE_HOST=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_NAMESPACE=agricultural-knowledge

# Weather API Service
WEATHER_API_KEY=open_meteo_live

# Object Storage for Crop Health Images (S3 Compatible)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=krishimind-crop-images
UPLOAD_DIR=./uploads

# Multilingual Settings
SUPPORTED_LANGUAGES=en,hi,gu
DEFAULT_LANGUAGE=en

# ============================================================
# KRISHIMIND AI — ENVIRONMENT TEMPLATE (.env.example)
# "Smarter farming decisions with AI."
# ============================================================

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8080/api

# Backend Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./backend/krishimind.db

# Authentication Security
JWT_SECRET=krishimind-secret-key-production-replace-with-secure-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini 3.7 Flash / Gemini Vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VISION_MODEL=gemini-3.7-flash

# ============================================================
# PINECONE VECTOR DATABASE (Official Agricultural RAG Store)
# ============================================================
VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=krishimind-agricultural-rag
PINECONE_HOST=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_NAMESPACE=agricultural-knowledge

# External Weather Integration
WEATHER_API_KEY=open_meteo_live

# S3 / Supabase Storage for Crop Pathology Images
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=krishimind-crop-images
UPLOAD_DIR=./backend/uploads

# Supported Languages
SUPPORTED_LANGUAGES=en,hi,gu
DEFAULT_LANGUAGE=en
